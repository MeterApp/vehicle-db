{
  "name": "@meterapp/vehicle-db",
  "version": "2.4.0",
  "description": "Offline international vehicle makes/models database — zero dependencies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeterApp/vehicle-db.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:db": "npm run build:data",
    "build:data": "tsx scripts/build-db.ts",
    "refresh:nhtsa": "tsx scripts/import-nhtsa.ts",
    "refresh:uk-dft": "tsx scripts/import-uk-dft.ts",
    "build:ts": "tsc",
    "build": "npm run build:ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "nhtsa",
    "dvla",
    "vehicles",
    "makes",
    "models",
    "motorcycles",
    "buses",
    "international",
    "offline"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
